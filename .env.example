# =====================================================================
# Blockchain-Based Credential Lifecycle Verification System
# Environment Configuration Template (.env.example)
#
# NOTE: This file contains non-secret placeholder defaults for development
# and deployment configuration. Never commit real production secrets, private keys,
# or production database credentials to version control.
# =====================================================================

# Environment mode: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Blockchain Credential Lifecycle Verification API"

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=credential_verification
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/credential_verification

# Storage & Encryption (AES-256-GCM)
# STORAGE_ENCRYPTION_KEY must be exactly 32 bytes (64 hex characters)
STORAGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
STORAGE_ROOT_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=10485760
CHALLENGE_EXPIRY_SECONDS=300

# Blockchain / EVM Configuration
# Set BLOCKCHAIN_RPC_URL to your EVM JSON-RPC provider
# For Sepolia public testnet: https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY
# For local EVM development: http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
BLOCKCHAIN_CHAIN_ID=11155111
CHAIN_ID=11155111
# Deployed contract addresses (populated upon contract deployment to target network)
ISSUER_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=
# Dedicated operational transaction signer private key (32 bytes hex).
# NEVER commit real private keys. Leave empty for read-only operation.
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
BLOCKCHAIN_TIMEOUT_SECONDS=10.0
CONFIRMATION_BLOCKS=1

# Authentication & Authorization (OpenID Connect / OAuth 2.0 / Local Dev)
# AUTH_MODE: "oidc" (production/standard) | "development"
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://auth.institutional-consortium.org/realms/credentials
OIDC_AUDIENCE=blockchain-credential-api
OIDC_JWKS_URL=
# Leave blank for local development (auto-generates 2048-bit RSA dev keypair)
AUTH_DEV_PUBLIC_KEY=
AUTH_DEV_PRIVATE_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

